{
  "name": "cv-submission-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:node": "node --test --test-isolation=none \"tests/*.test.mjs\"",
    "test:all": "vitest run && npm run test:node",
    "validate": "node cmd/validate.ts",
    "update": "node cmd/update.ts --write",
    "update:dry": "node cmd/update.ts --dry-run",
    "audit:privacy": "node scripts/check-privacy.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
